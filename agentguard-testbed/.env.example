# Run `make bootstrap` to generate `.env.local` with random local-only values.
POSTGRES_USER=generated-by-bootstrap
POSTGRES_PASSWORD=generated-by-bootstrap
POSTGRES_DB=aegisledger
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=generated-by-bootstrap
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=generated-by-bootstrap
DEV_RESEARCHER_PASSWORD=generated-by-bootstrap
DEV_POLICY_ADMIN_A_PASSWORD=generated-by-bootstrap
DEV_POLICY_ADMIN_B_PASSWORD=generated-by-bootstrap
DEV_AUDITOR_PASSWORD=generated-by-bootstrap
GRAFANA_ADMIN_PASSWORD=generated-by-bootstrap
AEGIS_POLICY_SIGNING_SEED=generated-by-bootstrap
AEGIS_POLICY_PUBLIC_KEY_HEX=generated-by-bootstrap
AEGIS_ALLOWED_POLICY_HASHES=generated-by-bootstrap
AEGIS_COMMIT_SHA=generated-by-bootstrap
AEGIS_SIGNER_IDENTITY=generated-by-bootstrap
AEGIS_ORGANIZATION_ID=local
AEGIS_DEPLOYMENT_ENVIRONMENT_ID=development
AEGIS_EXPERIMENT_MAX_ACTIVE_PER_PRINCIPAL=2
AEGIS_RATE_LIMIT_REQUESTS=120
AEGIS_RATE_LIMIT_WINDOW_SECONDS=60
AEGIS_REQUEST_MAX_BYTES=1000000
# Optional host-port overrides; container ports remain fixed.
AEGIS_API_PORT=8000
AEGIS_WEB_PORT=4173
